# local.env.example — copy this to local.env and fill in the values.
#
# local.env is gitignored and never committed. It is sourced by
# scripts/bootstrap.sh and scripts/install.sh.
#
# Required keys:
#   CLAUDE_CONFIG_DIR   — where the framework compiler writes the built config.
#                         For Claude Code, this is the directory Claude reads as
#                         its project config (e.g. ~/.claude or a custom path).
#   OBSIDIAN_VAULT_PATH — path to your durable-knowledge vault (a directory of
#                         Markdown files). Obsidian.app is optional — any editor
#                         that handles plain Markdown works.
#
# Set automatically by bootstrap.sh (do not set manually unless you know what you are doing):
#   AI_CONFIG_DIR       — absolute path to the ai-config repo checkout. Used by
#                         framework scripts and session-agent to locate source files.
#
# Optional keys: see templates/local.env.example in the ai-config repo for the
# full list (CODEX_HOME, etc.).

CLAUDE_CONFIG_DIR=$HOME/.claude
OBSIDIAN_VAULT_PATH=$HOME/notes
# AI_CONFIG_DIR is set automatically by bootstrap.sh via ~/.zshenv
