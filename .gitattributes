* text=auto

# UNIX text — LF line endings
*.sh        text eol=lf
*.json      text eol=lf
*.md        text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.py        text eol=lf
*.js        text eol=lf
*.ts        text eol=lf
Makefile    text eol=lf

# PowerShell — LF line endings (cross-platform; pwsh 7+ handles LF natively on
# Windows). Prior `eol=crlf` broke macOS/Linux pwsh: PS @'…'@ here-strings
# preserve literal bytes between delimiters, so CRLF in source files leaked
# `\r` into any here-string content passed to a line-sensitive tool (jq parser
# in scripts/check-drift.ps1's <TEAM>-106 soft-drift classifier was the trip).
# See <TEAM>-120 + [[reference_ps_port_traps]].
*.ps1       text eol=lf
*.psm1      text eol=lf
*.psd1      text eol=lf

# Genuinely Windows-only text — keep CRLF
*.cmd       text eol=crlf
*.bat       text eol=crlf

# Binary — do not normalize
*.png       binary
*.jpg       binary
*.gif       binary
*.ico       binary
*.pdf       binary
*.woff2     binary
