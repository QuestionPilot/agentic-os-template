filters:
  or:
    - file.inFolder("10-Wiki")
    - file.inFolder("20-Raw")
properties:
  file.folder:
    displayName: "Folder"
  file.name:
    displayName: "Note"
  file.tags:
    displayName: "Tags"
  status:
    displayName: "Status"
  file.mtime:
    displayName: "Updated"
views:
  - type: table
    name: "Knowledge"
    order:
      - file.folder
      - file.name
      - file.tags
      - status
      - file.mtime
