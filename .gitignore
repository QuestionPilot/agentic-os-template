.DS_Store
.env
.env.*
!.env.example
local.env

# Operator-local Hermes soul-identity overlay (SOUL_IDENTITY_PATH). Carries
# personal identity + machine paths; spliced into the rendered SOUL.md at build
# time and NEVER shipped — same operator-local, gitignored status as local.env.
local.soul-identity.md

# Operator-local catalog/rules overlays (SKILLS_OVERLAY_PATH /
# CODEX_RULES_OVERLAY_PATH). Carry the operator's full tool catalog and
# tool-policy rules; appended into the rendered SKILLS.md / AGENTS.md at build
# time and NEVER shipped — same operator-local, gitignored status as
# local.soul-identity.md. These are the recommended repo-root filenames from
# templates/local.env.example; left unanchored deliberately (matching the
# local.env / local.soul-identity.md entries) so a stray copy in a subdirectory
# cannot ship either.
local.skills-overlay.md
local.codex-rules-overlay.md

# Harness-local state: settings.local.json, plugin caches, EnterWorktree
# linked worktrees, etc. Never synced framework content. `.hermes/` is here
# because a repo-local HERMES_HOME renders SOUL.md (which now carries spliced
# operator identity) into the tree — ignore it so that PII can never be staged.
.claude/
.codex/
.hermes/

# Per-machine code-intelligence (codegraph) state — index DB and the
# project-local MCP config that pins an absolute path to the local binary.
# Both are personal install artifacts, not framework content.
.codegraph/
.mcp.json

# Cross-model-review runtime artifacts — per-run dirs under cross-model-out/
# (codex-review.md, gemini-review.md, reconciled.md, log.md ledger). Codex
# CLI prepends a `workdir: <abs-path>` metadata header on every `codex exec`
# capture; absent this gitignore (and the matching --exclude-dir in
# scripts/check-drift.sh), that header trips the machine-specific-path scan
# when validate.sh runs from a worktree where a run was captured. Driver-
# local, never framework content — parallel framing to .codegraph/. (<TEAM>-87.)
cross-model-out/

# Subagent / parallel-session worktrees — never tracked. Each session creates
# `worktrees/<issue-slug>/` for its own isolated checkout; these are operator-
# local state, not framework content.
worktrees/

# The operator's local project workspace — never tracked. scripts/new-project.sh
# (and its .ps1 twin) scaffold real project folders here from the two
# templates/project-*.md entrypoints; project work is the operator's own
# content, not framework content, so it must never pollute the tracked tree or
# conflict with a `git pull` of framework updates. Unanchored deliberately,
# matching the worktrees/ entry above.
projects/

# self-audit score history — runtime, per-operator state written by
# scripts/self-audit-history.{sh,ps1}. The default store lives at
# $CLAUDE_CONFIG_DIR/self-audit-history.jsonl, but ignore it repo-wide so it
# can never be staged even when an operator's $CLAUDE_CONFIG_DIR points inside
# a checkout. Parallel framing to cross-model-out/ + .build-manifest.json.
#
self-audit-history.jsonl

node_modules/
dist/
build/
coverage/
*.log
*.tmp
*.bak
*.backup
*.backup-*
auth.json
config.toml
/vault/
/codex/
browser-traces/
test-results/
screenshots/
generated_images/
