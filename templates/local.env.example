# Local environment template
#
# Copy this to the ai-config repo root as `local.env` and fill in machine-specific
# values. `local.env` is gitignored and must never be committed.
#
# install.sh reads this file. bootstrap.sh creates it.

# REQUIRED for the claude harness — absolute path to the harness config dir (the
# build target for `install.sh`, default `--harness claude`). This is the
# directory named by the CLAUDE_CONFIG_DIR environment variable.
CLAUDE_CONFIG_DIR=

# REQUIRED for the codex harness — absolute path to the Codex config dir (the
# build target for `install.sh --harness codex`). This is the directory named by
# the CODEX_HOME environment variable; Codex defaults it to ~/.codex. Quote it if
# the path contains spaces — this file is sourced.
CODEX_HOME=

# OPTIONAL — absolute path to this ai-config checkout. Defaults to the repo
# root that install.sh computes from its own location; set it only to override.
AI_CONFIG_DIR=

# OPTIONAL (claude harness) — absolute path to a local SKILLS overlay file. The
# shipped harnesses/claude/SKILLS.template.md is spine-only; install.sh appends
# this file's contents at the operator-overlay marker when set, reproducing your
# full plugin/family/MCP/CLI catalog in the rendered SKILLS.md. Leave empty for a
# spine-only render (the framework default — friends cloning the template start
# here). The overlay file is operator-local and is never shipped. Quote it if the
# path contains spaces — this file is sourced.
SKILLS_OVERLAY_PATH=

# See ai-config/obsidian/vault-guide.md §3 for vault setup walkthrough.
# REQUIRED — absolute path to the durable-knowledge vault. install.sh substitutes
# this into the generated harness entrypoint (`CLAUDE.md` or `AGENTS.md`, per
# the chosen --harness). Quote it if the path contains spaces — this file is
# sourced.
OBSIDIAN_VAULT_PATH=

# Existing keys (unrelated to install.sh; kept for other tooling).
ACTIVE_WORKSPACE_URL=

# See ai-config/linear/linear-setup.md §3 for Linear access surface setup
# (both lineark CLI and Linear MCP options). Optional — Linear access is
# operator-configured; the framework gracefully degrades when neither
# surface is installed.
LINEAR_WORKSPACE_URL=

DEFAULT_AI_HARNESS=
