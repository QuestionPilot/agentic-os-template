# Local environment template
#
# Copy this to the agentic-os-template repo root as `local.env` and fill in machine-specific
# values. `local.env` is gitignored and must never be committed.
#
# install.sh reads this file. bootstrap.sh creates it.

# REQUIRED for the claude harness — absolute path to the harness config dir (the
# build target for `install.sh`, default `--harness claude`). This is the
# directory named by the CLAUDE_CONFIG_DIR environment variable.
CLAUDE_CONFIG_DIR=

# REQUIRED for the codex harness — absolute path to the Codex config dir (the
# build target for `install.sh --harness codex`). This is the directory named by
# the CODEX_HOME environment variable; Codex defaults it to ~/.codex. Quote it if
# the path contains spaces — this file is sourced.
CODEX_HOME=

# REQUIRED for the hermes harness — absolute path to the Hermes home or profile
# dir (the build target for `install.sh --harness hermes`). This is the
# directory named by the HERMES_HOME environment variable; Hermes defaults it to
# ~/.hermes, and a dedicated profile dir is the safe target (see
# harnesses/hermes/adapter.md). Quote it if the path contains spaces — this file
# is sourced.
HERMES_HOME=

# OPTIONAL — absolute path to this agentic-os-template checkout. Defaults to the repo
# root that install.sh computes from its own location; set it only to override.
AI_CONFIG_DIR=

# OPTIONAL (claude harness) — absolute path to a local SKILLS overlay file. The
# shipped harnesses/claude/SKILLS.template.md is spine-only; install.sh appends
# this file's contents at the operator-overlay marker when set, reproducing your
# full plugin/family/MCP/CLI catalog in the rendered SKILLS.md. Leave empty for a
# spine-only render (the framework default — friends cloning the template start
# here). The overlay file is operator-local and is never shipped. Quote it if the
# path contains spaces — this file is sourced.
SKILLS_OVERLAY_PATH=

# OPTIONAL (codex harness) — absolute path to a local codex-rules overlay file.
# The shipped harnesses/codex/AGENTS.template.md is spine-only; install.sh
# --harness codex appends this file's contents at the operator-overlay marker
# when set, reproducing any operator tool-policy rules in the rendered AGENTS.md.
# Codex (unlike the claude harness) has no auto-loaded rules/ sidecar dir, so
# these rules must land in AGENTS.md itself. Leave empty for a spine-only render
# (the framework default — friends cloning the template start here). The overlay
# file is operator-local and is never shipped. Quote it if the path contains
# spaces — this file is sourced.
CODEX_RULES_OVERLAY_PATH=

# OPTIONAL — operator identity tokens for the cleanliness guard
# (scripts/check-clean.{sh,ps1}): comma-separated personal name / handle /
# hostname tokens the guard scans tracked CONTENT for, case-insensitively.
# Unset, the structural scans still run; only the personal-token classes are
# skipped. Never committed — the shipped guard carries zero operator identity.
OPERATOR_PII_TOKENS=

# OPTIONAL — commit-metadata identity allowlist for the cleanliness guard:
# comma-separated exact `Name <email>` entries. When set, check-clean FAILS any
# ahead-of-default branch commit whose author or committer is not on this list
# (content scans cannot see commit metadata — a clone with no repo-local git
# identity derives your personal name + machine hostname into public history).
# Unset, the check is a documented no-op. Quote the value — it contains spaces.
# Format limit: an identity whose NAME itself contains a comma cannot be
# expressed (the comma reads as a separator); the mismatch fails closed.
COMMIT_IDENTITY_ALLOWLIST=

# See obsidian/vault-guide.md §3 for vault setup walkthrough.
# REQUIRED — absolute path to the durable-knowledge vault. install.sh substitutes
# this into the generated harness entrypoint (`CLAUDE.md` or `AGENTS.md`, per
# the chosen --harness). Quote it if the path contains spaces — this file is
# sourced.
OBSIDIAN_VAULT_PATH=

# Existing keys (unrelated to install.sh; kept for other tooling).
ACTIVE_WORKSPACE_URL=

# See linear/linear-setup.md §3 for Linear access surface setup
# (both lineark CLI and Linear MCP options). Optional — Linear access is
# operator-configured; the framework gracefully degrades when neither
# surface is installed.
LINEAR_WORKSPACE_URL=

DEFAULT_AI_HARNESS=
